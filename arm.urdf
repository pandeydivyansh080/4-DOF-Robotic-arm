<?xml version="1.0"?>
<robot name="arm4dof">

  <material name="grey"><color rgba="0.55 0.55 0.6 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1"/></material>

  <!-- Fixed base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.12 0.12 0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  
  <!-- Joint 1: base rotation (around Z, continuous 360) -->
  <joint name="base_joint" type="continuous">
    <parent link="base_link"/>
    <child link="turntable"/>
    <origin xyz="0 0 0.04"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="turntable">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Joint 2: shoulder (around Y) -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="turntable"/>
    <child link="link1"/>
    <origin xyz="0 0 0.04"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.396" upper="1.396" effort="5" velocity="2"/>
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.08"/>
      <geometry><box size="0.03 0.03 0.16"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- Joint 3: elbow (around Y) -->
  <joint name="elbow_joint" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.16"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.396" upper="1.396" effort="5" velocity="2"/>
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.025 0.025 0.14"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Joint 4: wrist (around Y) -->
  <joint name="wrist_joint" type="revolute">
    <parent link="link2"/>
    <child link="wrist"/>
    <origin xyz="0 0 0.14"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.396" upper="1.396" effort="2" velocity="2"/>
  </joint>
  <link name="wrist">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

</robot>
